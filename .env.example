# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=

# PostgreSQL (docker-compose читает POSTGRES_*; бот — DATABASE_URL)
POSTGRES_USER=muallim
POSTGRES_PASSWORD=
POSTGRES_DB=muallim
DATABASE_URL=postgresql+asyncpg://muallim:ПАРОЛЬ@localhost:5432/muallim
# Три входа (ADR-0054): make db-roles создаёт роли и сам заполняет строки ниже, а DATABASE_URL
# переключает на muallim_app. Миграции — входом владельца, DBeaver — muallim_reader.
MIGRATION_DATABASE_URL=
APP_DB_PASSWORD=
READER_DB_PASSWORD=

# Распознавание: muaalem (модель, нужно `uv sync --extra ml`) или stub (заглушка без модели)
ASR_BACKEND=muaalem

# Методические пороги (решает человек, см. docs/pedagogy/methodology.md)
PASS_THRESHOLD=80
EXCELLENT_THRESHOLD=90

# Логи (ADR-0027): INFO в пилоте; DEBUG только локально — сетевые библиотеки печатают запросы
LOG_LEVEL=INFO
# Файл логов с ротацией 3 × 10 МБ (ADR-0048); пусто — только консоль
LOG_FILE=logs/bot.log

# Учителя (через запятую, Telegram ID): кнопка «🎙 Записать эталон» на карточках (ADR-0024).
# Узнать свой ID: написать @userinfobot в Telegram.
TEACHER_IDS=

# Разметчики (FR-17, ADR-0041): «код:Telegram ID» через запятую, например A1:123456,A2:789012.
# Отдельно от учителей. Разметчик пишет боту /annotate. Без перезапуска — приглашение:
# uv run muallim-research annotator-invite A2; закрыть доступ — annotator-revoke A2.
ANNOTATOR_IDS=
