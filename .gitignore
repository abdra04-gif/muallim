# Секреты
.env
.env.*
!.env.example

# Данные учеников и выгрузки — никогда в git
/data/
*.sqlite3
*.db
*.dump

# Отчёты могут содержать псевдонимы; коммитить осознанно (git add -f)
analytics/reports/*.md

# Служебное
.agent-phase
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
dist/
.DS_Store
.idea/
.vscode/

# Книга (скан издания, «все права защищены») — только локально, для исследования; см. book/README.md
book/*.pdf
book/pages/

# Сборка LaTeX
thesis/build/
logs/

# Чужие репозитории для справки (4,5 ГБ) — только локально, ADR-0063
/external/

# Jupyter-ноутбуки: в результатах ячеек — данные учеников (notebooks/README.md)
*.ipynb
.ipynb_checkpoints/

# Копии для параллельных сессий Claude (ADR-0073)
.claude/worktrees/
