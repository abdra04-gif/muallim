%% Что происходит, когда ученик присылает голосовое.
sequenceDiagram
    autonumber
    actor L as Ученик
    participant H as handlers.voice.on_voice
    participant UC as AssessRecitation
    participant R as MaroofListener
    participant D as domain.assess_best
    participant S as AudioStore
    participant DB as PostgreSQL

    L->>H: голосовое (OGG/Opus)
    alt на экране меню (главная, прогресс…) — ScreenState (learner_settings)
        H-->>L: VOICE_ON_HOME + «▶️ Продолжить» (не проверяется)
    else на экране карточка-правило
        H-->>L: VOICE_ON_RULE «это правило, нажми ▶️ Дальше»
    else карточка для чтения
    H->>UC: execute(learner, audio, item_id карточки на экране)
    UC->>R: listen(audio, текст карточки, long_is_short)
    R->>R: ffmpeg → 16 кГц, модель (под замком), фонетизация эталона (васл/вакф) → звуки модели
    R-->>UC: references, score_many(варианты), model_version
    UC->>D: decide в отдельном потоке: верное против типичных ошибок и «другого слога» (ADR-0088)
    D-->>UC: засчитано / ещё раз / ошибка, победивший вариант, маржи, подсказки
    alt есть согласие на исследование
        UC->>S: save(audio) → sha256
    end
    UC->>DB: attempt + след решения + detected_errors + событие (одна транзакция)
    UC-->>H: результат, объяснения на языке ученика, транскрипция
    H->>DB: StaffAccess.is_staff — учитель или разметчик?
    H-->>L: вердикт, ошибки по слогам, кнопки «Ещё раз / Дальше / 🔊 / 🚩» · «Услышано» и № попытки — только staff
    end
    opt ученик нажал «🚩 Бот ошибся»
        H-->>L: «Что не так с проверкой попытки № …?» (причины и «Отмена»)
        L->>H: причина
        H->>DB: learner_reports → первым в очередь разметки
    end
