    learners {
        uuid id PK
        bigint telegram_user_id UK "персональные данные"
        string pseudonym UK "для выгрузок"
        string current_item_id
        bool research_consent
        string feedback_language
    }
    consents {
        int id PK
        uuid learner_id FK
        string kind
        bool granted
        string text_version
    }
    learner_profiles {
        uuid learner_id PK,FK
        bool adult "18+"
        string native_language "родной язык"
        string arabic_reading "опыт чтения"
        string questionnaire_version
    }
    learner_settings {
        uuid learner_id PK,FK
        string how_to_read "spoiler / shown / hidden"
        bool daily_opening
        smallint reminder_minute "null — выкл."
        smallint utc_offset_min "по умолч. 180"
        string screen_item_id "null — меню"
        bool screen_opening
        string opening_resume_item
        date opening_day "местная дата"
        date opening_skipped_on
    }
    attempts {
        uuid id PK
        uuid learner_id FK
        string item_id "L18-02"
        string curriculum_version
        string model_version
        text reference_phonemes
        text heard_phonemes
        smallint score
        string verdict
        string audio_sha256 "null без согласия"
        string reference_variant "wasl / waqf"
        json candidates "все эталоны и баллы"
        json model_output "сырые данные модели"
        json policy "пороги"
        string app_version "версия кода"
        string feedback_language
    }
    curriculum_items {
        string curriculum_version PK
        string item_id PK
        string lesson_id
        string text "арабский текст строки"
        string note "«Обратите внимание»"
        smallint page "страница книги"
        smallint line "строка на странице"
        bool verified
    }
    learner_reports {
        int id PK
        uuid attempt_id FK "UNIQUE с learner_id"
        uuid learner_id FK
        string reason
    }
    detected_errors {
        int id PK
        uuid attempt_id FK
        string kind
        smallint position
        string expected
        string heard
        text message "что увидел ученик"
    }
    annotations {
        int id PK
        uuid attempt_id FK
        string annotator
        string label
        text corrected_phonemes
        string guide_version
        string source "excel | telegram"
        int seconds_spent
        bool self_corrected "сам исправился (2.1)"
    }
    interaction_events {
        int id PK
        uuid learner_id FK "SET NULL при удалении"
        string event
        json payload
    }

    quiz_answers {
        uuid id PK
        uuid learner_id FK "CASCADE"
        int round_no "UNIQUE с learner_id, position"
        smallint position
        smallint step "1 узнаю, 2 слышу, 3 читаю"
        string letter_id
        string item_id
        json options
        smallint picked
        bool correct "NULL — пропуск"
        uuid attempt_id FK "SET NULL"
        timestamptz shown_at
        timestamptz answered_at
    }
