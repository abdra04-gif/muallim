erDiagram
    learners ||--o{ consents : "журнал согласий"
    learners ||--o| learner_profiles : "анкета один раз"
    learners ||--o{ attempts : "читает"
    learners |o--o{ interaction_events : "действия"
    attempts ||--o{ detected_errors : "найдено моделью"
    attempts ||--o{ annotations : "размечено человеком"
    detected_errors |o--o{ annotations : "метка ошибки"
